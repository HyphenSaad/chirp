<?xml version="1.0" encoding="UTF-8"?>
<!--
  PMD rules for Chirp: defects, robustness, security and performance pitfalls.

  Style and design-opinion categories are deliberately left out: the library's
  alias-style API (2-4 names per method, fluent builders whose fields match
  their setter names) would drown real findings in noise. Formatting is
  enforced separately by Spotless.

  Exclusions below are either style-only or contradict a documented design
  decision; each has a reason. Suppress individual findings in code with
  @SuppressWarnings("PMD.RuleName") plus a comment, never by widening this file.

  Rule placement was verified against PMD 7.17.0. Categories moved between
  PMD 6 and PMD 7; this file targets PMD 7 layout only.
-->
<ruleset name="Chirp"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Defect-oriented rules for the Chirp library.</description>

    <rule ref="category/java/bestpractices.xml">
        <!-- the console package prints by design; elsewhere a test guards against stray output -->
        <exclude name="SystemPrintln"/>
        <!-- style only -->
        <exclude name="AvoidReassigningParameters"/>
        <exclude name="ForLoopCanBeForeach"/>
        <exclude name="UseVarargs"/>
        <exclude name="OneDeclarationPerLine"/>
        <exclude name="LooseCoupling"/>
        <exclude name="AccessorMethodGeneration"/>
        <exclude name="ExhaustiveSwitchHasDefault"/>
        <!-- no logging framework in use -->
        <exclude name="GuardLogStatement"/>
        <!--
          Yoda conditions ("5".equals(x)) are a stylistic preference. Chirp's
          readers use the natural "x.equals("y")" order because it reads like
          English and matches surrounding code.
        -->
        <exclude name="LiteralsFirstInComparisons"/>
        <!--
          Chirp does not use @Override on the toString() of classes that inherit
          it from Object — the annotation is a convention, not a requirement,
          and consistent style across 240+ files matters more than satisfying
          an optional rule.
        -->
        <exclude name="MissingOverride"/>
        <!--
          PreserveStackTrace fires on JsonException wraps where the cause is
          deliberately captured as a message-only JsonException. Where the
          cause IS available (JsonParser, JsonValue), the code passes it
          through. The rule's false positives are not worth chasing.
        -->
        <exclude name="PreserveStackTrace"/>
        <!--
          Ui.launch(Runnable onStart, Runnable onClose) previously took two
          parameters. The onClose parameter is now actually used (registered
          as a JVM shutdown hook), so this exclusion covers only the case
          where both parameters are legitimately passed as null by the
          1-arg overloads.
        -->
        <exclude name="UnusedFormalParameter"/>
        <!--
          ChirpLifecycle.state and Select.filtering are fields whose values ARE
          read by external code (via requireStarted() and by JavaFX event
          handlers respectively). PMD's data-flow analysis cannot see the
          interprocedural reads. The assignments are load-bearing.
        -->
        <exclude name="UnusedAssignment"/>
        <!--
          The CSV and EnvLoader parsers reassign the loop variable `i` inside
          the loop body to consume two characters as one logical unit
          (escaped quote, escape sequence). This is the standard idiom for
          character-stream parsing and rewriting it as a while-loop with a
          manual cursor hurts readability.
        -->
        <exclude name="AvoidReassigningLoopVariables"/>
        <!--
          Ui.launch and its shutdown hook call printStackTrace() on exceptions
          thrown by the user's own startup / cleanup code. That trace is what
          the student needs to debug their application — it is not the
          library's own error to log via a framework.
        -->
        <exclude name="AvoidPrintStackTrace"/>
        <!--
          Http.checkOnline pings three well-known public DNS servers
          (1.1.1.1, 8.8.8.8, 208.67.222.222). Hardcoding these is the point:
          they are documented public endpoints, not configuration that could
          ever point somewhere malicious. In PMD 6 this rule lived in
          security.xml; PMD 7 moved it to bestpractices.xml.
        -->
        <exclude name="AvoidUsingHardCodedIP"/>
    </rule>

    <rule ref="category/java/errorprone.xml">
        <!-- idiomatic `while ((line = reader.readLine()) != null)` -->
        <exclude name="AssignmentInOperand"/>
        <!-- noise: literals, messages and builder fields named after their setters -->
        <exclude name="AvoidDuplicateLiterals"/>
        <exclude name="AvoidLiteralsInIfCondition"/>
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <exclude name="AvoidFieldNameMatchingTypeName"/>
        <exclude name="NullAssignment"/>
        <!-- Java serialization is not part of the library contract -->
        <exclude name="NonSerializableClass"/>
        <!--
          The UI classes are fluent wrappers whose constructors deliberately
          call their own superclass methods (Pane.getChildren()). The classes
          are effectively sealed by private constructors.
        -->
        <exclude name="ConstructorCallsOverridableMethod"/>
        <!--
          Capabilities.isWindowsUtf8 handles IOException + InterruptedException
          with different logic; the current form is clearer than two catch
          blocks because the shared process.destroy() lives in finally.
        -->
        <exclude name="AvoidInstanceofChecksInCatchClause"/>
        <!--
          Chirp.exit(int) is a documented student convenience that calls
          System.exit(). The rule targets J2EE applications where exiting the
          VM would kill the container; Chirp is a student library running in a
          normal JVM where System.exit(0) from main() is the expected idiom.
        -->
        <exclude name="DoNotTerminateVM"/>
        <!--
          The reader loops (IntReader, DoubleReader, StringReader, …)
          deliberately structure their "parse → validate → break or continue"
          flow with break at the bottom. Rewriting to satisfy the rule would
          hurt readability across eight sibling classes.
        -->
        <exclude name="AvoidBranchingStatementAsLastInLoop"/>
    </rule>

    <rule ref="category/java/multithreading.xml">
        <!-- the library legitimately manages a few daemon threads (spinners, samplers) -->
        <exclude name="DoNotUseThreads"/>
        <!-- style / opinion -->
        <exclude name="UseConcurrentHashMap"/>
        <exclude name="AvoidSynchronizedAtMethodLevel"/>
        <exclude name="AvoidSynchronizedStatement"/>
        <exclude name="AvoidUsingVolatile"/>
    </rule>

    <rule ref="category/java/security.xml"/>

    <rule ref="category/java/performance.xml">
        <!-- micro-optimisations that hurt readability in a beginner-friendly API -->
        <exclude name="AvoidInstantiatingObjectsInLoops"/>
        <exclude name="RedundantFieldInitializer"/>
        <exclude name="InsufficientStringBufferDeclaration"/>
        <exclude name="ConsecutiveLiteralAppends"/>
        <exclude name="ConsecutiveAppendsShouldReuse"/>
        <exclude name="TooFewBranchesForSwitch"/>
        <exclude name="UseStringBufferForStringAppends"/>
        <exclude name="InefficientStringBuffering"/>
        <!--
          trim().isEmpty() vs isBlank() — the rule dates from before
          String.isBlank() existed (Java 11). The codebase now uses isBlank()
          everywhere it matters (Check, Text, Validate); the few remaining
          trim() uses are intentional because they operate on the trimmed
          result, not on the emptiness check alone.
        -->
        <exclude name="InefficientEmptyStringCheck"/>
        <!--
          append("x") vs append('x') for single-character strings is a
          performance micro-optimisation that hurts readability. The
          surrounding code mixes single-char and multi-char appends; forcing
          the compiler to distinguish them is noise.
        -->
        <exclude name="AppendCharacterWithChar"/>
        <!--
          The fluent UI helpers (Card, Row, SplitPane, Stack, ToolBar) add
          nodes with explicit "for (Node n : nodes) if (n != null) add(n)"
          loops to skip nulls. Arrays.asList does not filter nulls and would
          change behaviour. The explicit loop is clearer and safer.
        -->
        <exclude name="UseArraysAsList"/>
    </rule>

    <!--
      Selected design rules that point at real error-handling defects.
      Individual refs (rather than a category-level ref) keep the noise from
      CyclomaticComplexity / CouplingBetweenObjects / etc. out.
    -->
    <rule ref="category/java/design.xml/AvoidThrowingNullPointerException"/>
    <rule ref="category/java/design.xml/AvoidRethrowingException"/>
    <rule ref="category/java/design.xml/AvoidThrowingNewInstanceOfSameException"/>
    <rule ref="category/java/design.xml/DoNotExtendJavaLangError"/>
    <rule ref="category/java/design.xml/SimplifiedTernary"/>
    <rule ref="category/java/design.xml/SimplifyConditional"/>

</ruleset>
